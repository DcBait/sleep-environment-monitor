{
  "__inputs": [
    {
      "name": "DS_SLEEP_MONITOR",
      "label": "Sleep Monitor DB",
      "description": "PostgreSQL datasource on Oracle Cloud VM",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    }
  ],
  "annotations": { "list": [] },
  "description": "IoT bedroom environment monitor — temperature, humidity, pressure and snore detection from ESP32",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Session Duration",
      "description": "Total recording time last night",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT session_duration_minutes FROM mart.mart_sleep_summary ORDER BY sleep_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 360 },
              { "color": "green", "value": 420 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg Temperature",
      "gridPos": { "x": 5, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg_temperature FROM mart.mart_sleep_summary ORDER BY sleep_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 22 },
              { "color": "yellow", "value": 26 },
              { "color": "red", "value": 28 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg Humidity",
      "gridPos": { "x": 9, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg_humidity FROM mart.mart_sleep_summary ORDER BY sleep_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 40 },
              { "color": "yellow", "value": 65 },
              { "color": "red", "value": 75 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Snore Events",
      "description": "Total 30-second windows where snoring was detected",
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT total_snore_events FROM mart.mart_sleep_summary ORDER BY sleep_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Snore Rate",
      "description": "% of 30-second windows with snoring detected",
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND((snore_rate * 100)::NUMERIC, 1) AS snore_rate_pct FROM mart.mart_sleep_summary ORDER BY sleep_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Temperature",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT event_ts AS \"time\", temperature AS \"Temperature (°C)\" FROM staging.stg_sensor_events WHERE $__timeFilter(event_ts) ORDER BY event_ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "#FF6B6B" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "°C",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["mean", "min", "max"]
        }
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Humidity",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT event_ts AS \"time\", humidity AS \"Humidity (%)\" FROM staging.stg_sensor_events WHERE $__timeFilter(event_ts) ORDER BY event_ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": { "mode": "fixed", "fixedColor": "#5794F2" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "%",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["mean", "min", "max"]
        }
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Snore Events",
      "description": "1 = snore detected in that 30-second window",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 5 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT event_ts AS \"time\", snore_detected::INT AS \"Snore\" FROM staging.stg_sensor_events WHERE $__timeFilter(event_ts) ORDER BY event_ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "color": { "mode": "fixed", "fixedColor": "#B877D9" },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "barMaxWidth": 4,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Silent" }, "1": { "text": "Snore" } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 9,
      "type": "row",
      "title": "7-Day Trends",
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Nightly Snore Rate",
      "description": "% of recording windows with snoring detected, per night",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT sleep_date::TIMESTAMPTZ AS \"time\", ROUND((snore_rate * 100)::NUMERIC, 1) AS \"Snore Rate %\" FROM mart.mart_sleep_summary WHERE sleep_date >= CURRENT_DATE - 7 ORDER BY sleep_date",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#B877D9" },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "barMaxWidth": 40,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "%",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean"] }
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Session Duration by Night",
      "description": "Recording duration in minutes per sleep session",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_SLEEP_MONITOR}" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT sleep_date::TIMESTAMPTZ AS \"time\", session_duration_minutes AS \"Duration (min)\" FROM mart.mart_sleep_summary WHERE sleep_date >= CURRENT_DATE - 7 ORDER BY sleep_date",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#73BF69" },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "barMaxWidth": 40,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "min",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean"] }
      },
      "pluginVersion": "10.0.0"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 38,
  "tags": ["sleep", "iot", "environment"],
  "time": { "from": "now-12h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Singapore",
  "title": "Sleep Environment Monitor",
  "uid": "sleep-env-monitor",
  "version": 1,
  "weekStart": ""
}
